# SELECTOR — the client-facing tier, replacing the current single backend at
# ws://192.168.122.68:1235. Routes each analyze query by its wire `model`
# label; there is NO fallback across labels, so a query for one model can
# never be served by the other (SelectorRouter dispatch is a labelled-dict
# lookup, proxy-fable router.py:1601ff).
#
# Run on 192.168.122.68 from the kataproxy checkout:
#   set -a; source selector.env; set +a; python ./proxy_server.py

PROXY_ROLE=SELECTOR

# The SPA connects from outside the VM, so bind non-loopback (same exposure
# as the currently running proxy on this port; it has no auth — keep it on
# the trusted libvirt network only).
PROXY_HOST=0.0.0.0
PROXY_PORT=1235

# `main` = the shared model served by BOTH 1301 and 1302, reached through the
# RELAY tier on this same VM (relay.env, loopback :1236).
# `alt`  = the different model on 1401, reached directly — a single leaf
# needs no load-balancing tier above it.
# Labels are what the SPA shows in its model dropdown (query_models reads
# them live), so rename freely — but rename in the SPA's saved settings too
# if any query pins a label.
SELECTOR_MODELS=main=ws://127.0.0.1:1236,alt=ws://192.168.122.1:1401
