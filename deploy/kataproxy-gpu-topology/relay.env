# RELAY — the load-balancing tier over the two same-model leaves.
# Consistent-hash ring on canonical_id with a load-aware fallback walk at
# RELAY_MAX_LOAD in-flight queries per upstream (proxy-fable benchmark.md,
# "Hash ring" / "Load-aware fallback"). Only INTERCHANGEABLE upstreams may
# appear here — both leaves must serve the SAME model; the different-model
# leaf (1401) is deliberately absent and lives on its own SELECTOR label.
#
# Run on 192.168.122.68 from the kataproxy checkout, BEFORE the selector:
#   set -a; source relay.env; set +a; python ./proxy_server.py

PROXY_ROLE=RELAY

# Only the SELECTOR on this same VM talks to the relay — keep it loopback.
PROXY_HOST=127.0.0.1
PROXY_PORT=1236

# The operator-provisioned same-model leaves.
UPSTREAM_URLS=ws://192.168.122.1:1301,ws://192.168.122.1:1302

# Default 10. The benchmark found cluster throughput insensitive to this
# knob across 1-32; it only changes how often the fallback walk fires.
# Leave at default until measurement says otherwise.
#RELAY_MAX_LOAD=10
